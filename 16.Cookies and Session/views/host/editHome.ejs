<%- include('../partials/hd') %>

<body class="bg-gray-100 min-h-screen">

  <%- include('../partials/header') %>

  <main class="container mx-auto px-4 py-12">

    <div class="max-w-xl mx-auto">

      <!-- Heading -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">
          <%= editing ? "Update the home" : "Register Your Home"%>
        </h1>
        <% if(!editing) { %>
          <p class="text-gray-500 mt-2">
            Add your property and start hosting guests.
          </p>
        <% } %>
      </div>

      <!-- Form Card -->
      <div class="bg-white rounded-xl shadow-lg p-8">

        <form action="<%= !editing ? '/add-home' : '/host/edit-home'%>" method="POST" class="space-y-6">

          <% if(editing) { %>
            <input type="text" hidden name="id" value="<%=home._id%>">
          <% } %>

          <!-- House Name -->
          <div>
            <label
              for="housename"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              House Name
            </label>

            <input
              type="text"
              id="housename"
              name="housename"
              placeholder="Enter the name of your house"
              value="<%= editing ? home.housename : ''%>"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg
                     text-gray-700 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-red-400
                     focus:border-red-400 transition duration-200"
            >
          </div>

          <!-- Price -->
          <div>
            <label
              for="price"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Price per Night
            </label>

            <div class="relative">
              <span
                class="absolute left-4 top-1/2 -translate-y-1/2
                       text-gray-500"
              >
                ₹
              </span>

              <input
                type="number"
                id="price"
                name="price"
                placeholder="Enter price per night"
                value="<%= editing ? home.price : ''%>"
                class="w-full pl-9 pr-4 py-3 border border-gray-300
                       rounded-lg text-gray-700 placeholder-gray-400
                       focus:outline-none focus:ring-2 focus:ring-red-400
                       focus:border-red-400 transition duration-200"
              >
            </div>
          </div>

          <!-- Location -->
          <div>
            <label
              for="location"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Location
            </label>

            <input
              type="text"
              id="location"
              name="location"
              placeholder="Enter the location of your house"
              value="<%= editing ? home.location : ''%>"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg
                     text-gray-700 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-red-400
                     focus:border-red-400 transition duration-200"
            >
          </div>

           <div>
            <label
              for="rating"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Rating
            </label>

            <input
              type="text"
              id="rating"
              name="rating"
              placeholder="Enter the rating of your house"
              value="<%= editing ? home.rating : ''%>"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg
                     text-gray-700 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-red-400
                     focus:border-red-400 transition duration-200"
            >
          </div>

           <div>
            <label
              for="photourl"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Photo url
            </label>

            <input
              type="text"
              id="photourl"
              name="photourl"
              placeholder="Enter the url for photo of your house"
              value="<%= editing ? home.photourl : ''%>"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg
                     text-gray-700 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-red-400
                     focus:border-red-400 transition duration-200"
            >
          </div>

          <div>
            <label
              for="description"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Description
            </label>

            <textarea
              id="description"
              name="description"
              placeholder="Enter the description of your house"
              value=""
              class="w-full px-4 py-3 border border-gray-300 rounded-lg
                     text-gray-700 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-red-400
                     focus:border-red-400 transition duration-200"
            ><%= editing ? home.description : ''%></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-red-500 text-white font-semibold
                   py-3 px-6 rounded-lg
                   hover:bg-red-600
                   focus:outline-none focus:ring-2
                   focus:ring-red-400 focus:ring-offset-2
                   shadow-md hover:shadow-lg
                   transition duration-300"
          >
            <%= editing ? "Update home" : "Register Home"%>
          </button>

        </form>

      </div>

    </div>

  </main>

</body>
</html>