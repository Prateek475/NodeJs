<%- include('partials/hd') %>
<body>
  <%- include('partials/header') %>
  <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
    <h2 class="text-gray-800 font-bold text-center mb-6">
      Here our registered homes:
    </h2>
    <ul class="mt-6 space-y-4">
      <% regHomes.forEach(home => {%>
      <li class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4
               text-lg font-semibold text-gray-700
               shadow-sm hover:shadow-md hover:bg-gray-100
               transition duration-300"><%= home.housename %>
        </li>
      <% });%>
    </ul>
  </main>
</body>
</html>