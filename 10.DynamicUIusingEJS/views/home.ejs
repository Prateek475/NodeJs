 <!DOCTYPE html>
<html lang="en">
<head>
  <title>Air bnb home page</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body>
  <header class="bg-red-500 text-white p-4 shadow-md">

    <nav class="container mx-auto flex justify-between items-center">

      <ul class="flex space-x-4">

        <li>
          <a href="/" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">
            Go to Home
          </a>
        </li>

        <li>
          <a href="/add-home" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">
            Add home
          </a>
        </li>

      </ul>

    </nav>

  </header>
  <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
    <h2 class="text-gray-800 font-bold text-center mb-6">
      Here our registered homes:
    </h2>
    <ul class="mt-6 space-y-4">
      <% regHomes.forEach(home => {%>
      <li class="bg-gray-50 border border-gray-200 rounded-lg px-5 py-4
               text-lg font-semibold text-gray-700
               shadow-sm hover:shadow-md hover:bg-gray-100
               transition duration-300"><%= home.housename %>
        </li>
      <% });%>
    </ul>
  </main>
</body>
</html>