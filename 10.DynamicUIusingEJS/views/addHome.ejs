<%- include('partials/hd') %>
<body>
 <%- include('partials/header') %>
  <h1 class="text-3xl font-bold text-gray-800 text-center mt-10">
  Register your home here...
</h1>

<main class="container mx-auto max-w-xl mt-8 bg-white shadow-lg rounded-lg p-8">

  <form action="/add-home" method="post" class="flex flex-col gap-5">

    <div>
      <label for="housename" class="block text-gray-700 font-semibold mb-2">
        House Name
      </label>

      <input
        type="text"
        id="housename"
        placeholder="Enter the name of your house"
        name="housename"
        class="w-full border border-gray-300 rounded-lg px-4 py-3
               text-gray-700 outline-none
               focus:ring-2 focus:ring-red-400 focus:border-red-400
               transition duration-200"
      >
    </div>

    <button
      type="submit"
      class="bg-red-500 text-white font-semibold py-3 px-6 rounded-lg
             hover:bg-red-600 shadow-md hover:shadow-lg
             transition duration-300"
    >
      Submit
    </button>

  </form>

</main>
</body>
</html>